# Local development / deployment template. NEVER commit a real .env file.
PORT=3000
NODE_ENV=development

# Admin dashboard
ADMIN_KEY=replace-with-a-long-random-secret

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/dr_pn_singh?retryWrites=true&w=majority

# Appointment numbering
# New production sequence starts fresh at 0000001.
INITIAL_NEXT_APPOINTMENT_NUMBER=1

# Clinic public contact (optional)
CLINIC_PHONE=
CLINIC_EMAIL=

# Payment
CLINIC_UPI_ID=
CLINIC_PAYMENT_NAME=Dr. P. N. Singh

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
CLINIC_WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verification-secret

# Approved WhatsApp template names
# Keep these aligned with the existing working WhatsApp setup.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_REQUEST_RECEIVED=appointment_request_received
WHATSAPP_TEMPLATE_CLINIC_ALERT=clinic_new_appointment
WHATSAPP_TEMPLATE_ACCEPTED=appointment_accepted
WHATSAPP_TEMPLATE_CANCELLED=appointment_cancelled
